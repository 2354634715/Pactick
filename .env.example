APP_ENV=development
HTTP_ADDRESS=127.0.0.1:8080
HTTP_BEHIND_PROXY=false
TLS_CERT_FILE=
TLS_KEY_FILE=
TRUSTED_PROXIES=
DATABASE_URL=postgres://pactick:pactick@localhost:5432/pactick?sslmode=disable
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_MIGRATE=true
REGISTRATION_ENABLED=true
DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=10s
ALLOWED_ORIGINS=
# One-line JSON; leave empty for status=not_configured. See docs/CLIENT_UPDATES.md.
CLIENT_UPDATE_MANIFEST_JSON=
