APP_ENV=development
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://pactick:pactick@localhost:5432/pactick?sslmode=disable
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_MIGRATE=true
REGISTRATION_ENABLED=true
DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=10s
ALLOWED_ORIGINS=
# One-line JSON; leave empty for status=not_configured. See docs/CLIENT_UPDATES.md.
CLIENT_UPDATE_MANIFEST_JSON=
