# Temporary HTTP-only site used for DNS and ACME validation.
# Render ${API_DOMAIN} before enabling this file. It intentionally does not
# proxy application requests over cleartext HTTP.
server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/pactick-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
