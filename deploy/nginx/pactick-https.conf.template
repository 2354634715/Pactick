# Render ${API_DOMAIN} and ${PACTICK_HTTP_PORT} before enabling this file.
map $http_upgrade $pactick_connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=pactick_register:10m rate=3r/m;
limit_req_zone $binary_remote_addr zone=pactick_auth:10m rate=10r/m;
limit_req_status 429;

upstream pactick_api {
    server 127.0.0.1:${PACTICK_HTTP_PORT};
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${API_DOMAIN};
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/pactick-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${API_DOMAIN};
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/${API_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${API_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Enable only after HTTPS and certificate renewal have been observed in
    # production: add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    client_max_body_size 2m;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    location = /v1/auth/register {
        limit_req zone=pactick_register burst=2 nodelay;
        proxy_pass http://pactick_api;
    }

    location = /v1/auth/login {
        limit_req zone=pactick_auth burst=5 nodelay;
        proxy_pass http://pactick_api;
    }

    location = /v1/auth/refresh {
        limit_req zone=pactick_auth burst=10 nodelay;
        proxy_pass http://pactick_api;
    }

    location = /v1/ws {
        # proxy_set_header directives do not partially inherit in Nginx once a
        # location defines one, so repeat the common forwarding headers here.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $pactick_connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
        proxy_pass http://pactick_api;
    }

    location / {
        proxy_pass http://pactick_api;
    }
}
