# Copy to /opt/pactick/config/api.env and set mode 0600.
APP_ENV=production
HTTP_ADDRESS=:8080
DATABASE_URL=postgres://pactick:REPLACE_ME@postgres:5432/pactick?sslmode=disable
AUTH_JWT_SECRET=REPLACE_ME
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
AUTO_MIGRATE=false
REGISTRATION_ENABLED=false
DB_MAX_CONNS=10
SHUTDOWN_TIMEOUT=15s
ALLOWED_ORIGINS=
# Single-quote one-line JSON in this shell-sourced file. See docs/CLIENT_UPDATES.md.
CLIENT_UPDATE_MANIFEST_JSON=
